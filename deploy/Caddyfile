{
	admin 127.0.0.1:2019
}

(starsnap_http_access_log) {
	log {
		output file /var/log/starsnap-http/access.log {
			mode 0600
			roll_size 10MiB
			roll_keep 5
			roll_uncompressed
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				request>tls delete
				request>uri regexp "\?.*$" ""
				resp_headers delete
				user_id delete
			}
		}
	}
}

(security_probe_guard) {
	@security_probe {
		path */.env */.env.* */.env/* */.git */.git/* */wp-login.php */wp-login.php/* */phpmyadmin */phpmyadmin/*
	}

	handle @security_probe {
		header X-StarSnap-Edge-Guard "scanner-probe"
		respond 404
	}
}

starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy website:3000
	}
}

api.starsnap.kr {
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy starsnap-main_api:8080
	}
}

erp.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@erp_health path /api/health /api/health/*
	handle @erp_health {
		respond 404
	}
	handle {
		reverse_proxy {
			dynamic a tasks.starsnap-erp_web 3000 {
				refresh 5s
				versions ipv4
			}
			lb_policy round_robin
		}
	}
}

sns.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy starsnap-sns_web:3000
	}
}

chat.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-StarSnap-App-Surface "chat"
	}
	handle {
		reverse_proxy starsnap-sns_web:3000
	}
}

bible.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-StarSnap-App-Surface "bible"
	}

	@bible_api path /api/bible/* /api/health
	handle @bible_api {
		reverse_proxy starsnap-bible_server:8080
	}
	@bible_blocked_api path /api/*
	handle @bible_blocked_api {
		respond 404
	}
	handle {
		reverse_proxy starsnap-bible_web:3000
	}
}

admin.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@admin_api path /api/*
	log_skip @admin_api
	handle @admin_api {
		reverse_proxy starsnap-admin_server:8082
	}
	handle {
		reverse_proxy starsnap-admin_web:5174
	}
}

log.starsnap.kr {
	import starsnap_http_access_log
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@log_dashboard_api path /api/dashboard/*
	handle @log_dashboard_api {
		reverse_proxy starsnap-log_server:8081
	}

	@log_blocked_api path /api/*
	handle @log_blocked_api {
		respond 404
	}

	handle {
		reverse_proxy starsnap-log_web:5173
	}
}

www.starsnap.kr {
	import starsnap_http_access_log
	redir https://starsnap.kr{uri} permanent
}

http://www.starsnap.kr {
	import starsnap_http_access_log
	redir https://starsnap.kr{uri} permanent
}
