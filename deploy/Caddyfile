admin.starsnap.kr {
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@admin_api path /api/*
	handle @admin_api {
		reverse_proxy starsnap-admin_server:8082
	}
	handle {
		reverse_proxy starsnap-admin_web:5174
	}
}

log.starsnap.kr {
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@log_dashboard_api path /api/dashboard/*
	handle @log_dashboard_api {
		reverse_proxy starsnap-log_server:8081
	}

	@log_blocked_api path /api/*
	handle @log_blocked_api {
		respond 404
	}

	handle {
		reverse_proxy starsnap-log_web:5173
	}
}

www.starsnap.kr {
	redir https://starsnap.kr{uri} permanent
}

http://www.starsnap.kr {
	redir https://starsnap.kr{uri} permanent
}
