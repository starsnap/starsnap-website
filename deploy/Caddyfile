{
	admin 127.0.0.1:2019
}

(security_probe_guard) {
	@security_probe {
		path */.env */.env.* */.env/* */.git */.git/* */wp-login.php */wp-login.php/* */phpmyadmin */phpmyadmin/*
	}

	handle @security_probe {
		header X-StarSnap-Edge-Guard "scanner-probe"
		respond 404
	}
}

starsnap.kr {
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy website:3000
	}
}

api.starsnap.kr {
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy starsnap-main_api:8080
	}
}

erp.starsnap.kr {
	encode zstd gzip
	import security_probe_guard
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@erp_health path /api/health /api/health/*
	handle @erp_health {
		respond 404
	}
	handle {
		reverse_proxy starsnap-erp_web:3000
	}
}

sns.starsnap.kr {
	encode zstd gzip
	import security_probe_guard

	handle {
		reverse_proxy starsnap-sns_web:3000
	}
}

chat.starsnap.kr {
	encode zstd gzip
	import security_probe_guard
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-StarSnap-App-Surface "chat"
	}
	handle {
		reverse_proxy starsnap-sns_web:3000
	}
}

