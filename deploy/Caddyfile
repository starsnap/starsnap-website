{
	admin 127.0.0.1:2019
}

starsnap.kr {
	encode zstd gzip
	reverse_proxy website:3000
}

api.starsnap.kr {
	encode zstd gzip
	reverse_proxy starsnap-main_api:8080
}

erp.starsnap.kr {
	encode zstd gzip
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@erp_health path /api/health /api/health/*
	handle @erp_health {
		respond 404
	}
	handle {
		reverse_proxy starsnap-erp_web:3000
	}
}

sns.starsnap.kr {
	encode zstd gzip
	reverse_proxy starsnap-sns_web:3000
}

chat.starsnap.kr {
	encode zstd gzip
	header {
		Content-Security-Policy "frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-StarSnap-App-Surface "chat"
	}
	reverse_proxy starsnap-sns_web:3000
}

admin.starsnap.kr {
	encode zstd gzip
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@admin_api path /api/*
	handle @admin_api {
		reverse_proxy starsnap-admin_server:8082
	}
	handle {
		reverse_proxy starsnap-admin_web:5174
	}
}

log.starsnap.kr {
	encode zstd gzip
	header {
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}

	@log_dashboard_api path /api/dashboard/*
	handle @log_dashboard_api {
		reverse_proxy starsnap-log-server:8081
	}

	@log_blocked_api path /api/*
	handle @log_blocked_api {
		respond 404
	}

	handle {
		reverse_proxy starsnap-log-web:5173
	}
}

www.starsnap.kr {
	redir https://starsnap.kr{uri} permanent
}

http://www.starsnap.kr {
	redir https://starsnap.kr{uri} permanent
}
